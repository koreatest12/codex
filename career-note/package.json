{
  "name": "career-note",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-pnpm.sh",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --max-warnings 0",
    "db:generate": "drizzle-kit generate",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "test:security": "node --test tests/security-dependencies.test.cjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^5.9.2",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.4",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.59.0",
    "mammoth": "^1.13.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.4.299",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.90.0",
    "react-resizable-panels": "^4.14.6",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.7.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.2",
    "json-rpc-2.0": "1.8.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.2.1",
    "vite": "8.3.4",
    "wrangler": "4.151.1"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0"
}
