new file mode 100644
index 0000000000000000000000000000000000000000..12fa90da0b4d194d3f1fe933e823c97f8b3e6a56
--- /dev/null
+++ b/lib/assert-depth.js
@@ -0,0 +1,17 @@
+'use strict';
+// Bound recursive walkers even when callers supply an AST directly.
+module.exports = ast => {
+  const pending = [[ast, 0]];
+  const seen = new Set();
+  while (pending.length) {
+    const [node, depth] = pending.pop();
+    if (!node || typeof node !== 'object') continue;
+    if (depth >= 128 || seen.has(node)) {
+      throw new SyntaxError('Brace AST exceeds safe depth or contains repeated nodes');
+    }
+    seen.add(node);
+    if (Array.isArray(node.nodes)) {
+      for (const child of node.nodes) pending.push([child, depth + 1]);
+    }
+  }
+};
